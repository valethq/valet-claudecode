{
  "schema": 1,
  "id": "valet-claudecode",
  "name": "Claude Code",
  "version": "0.1.0",
  "description": "inference@1 agent provider claude-code over the Claude Agent SDK.",
  "valet": "^0.1.0",
  "main": "./src/index.ts",
  "provides": ["inference@1", "settings@2"],
  "optionalRequires": ["transport@1"],
  "settings": {
    "sections": {
      "inference": {
        "subsections": [
          {
            "id": "behaviour",
            "label": "Behaviour",
            "items": [
              {
                "id": "permissionMode",
                "label": "Permission mode",
                "summary": "Claude Code's permission mode for new and resumed sessions. Valet's tool gate still sees every call.",
                "input": {
                  "type": "select",
                  "options": [
                    {
                      "value": "default",
                      "label": "Ask first"
                    },
                    {
                      "value": "acceptEdits",
                      "label": "Accept edits"
                    },
                    {
                      "value": "plan",
                      "label": "Plan"
                    },
                    {
                      "value": "bypassPermissions",
                      "label": "Bypass permissions"
                    }
                  ],
                  "default": "acceptEdits",
                  "style": "cards"
                }
              },
              {
                "id": "utilityModel",
                "label": "Utility model",
                "summary": "Model and effort for small side jobs such as naming sessions. No model turns them off.",
                "input": {
                  "type": "group",
                  "layout": "row",
                  "inputs": [
                    {
                      "id": "model",
                      "type": "ref",
                      "label": "Model",
                      "placeholder": "Off",
                      "options": {
                        "from": "models"
                      }
                    },
                    {
                      "id": "effort",
                      "type": "select",
                      "label": "Effort",
                      "options": {
                        "from": "efforts",
                        "args": {
                          "model": {
                            "$": "utilityModel.model"
                          }
                        }
                      },
                      "when": {
                        "set": "utilityModel.model"
                      }
                    }
                  ],
                  "default": {
                    "model": "claude-haiku-5-5"
                  }
                },
                "migrate": [
                  {
                    "map": {
                      "match": "^\\s*(?<model>claude-(?:opus|sonnet|haiku|fable)(?:-\\d+)+(?=-(?:low|medium|high|xhigh|max)\\s*$|\\s*$)|.*)(?:-(?<effort>low|medium|high|xhigh|max))?\\s*$"
                    }
                  }
                ]
              },
              {
                "id": "rateLimitNoticeAt",
                "label": "Usage warning threshold",
                "summary": "Only warn about approaching a limit at or above this share. Hitting a limit always shows.",
                "input": {
                  "type": "percent",
                  "min": 0,
                  "max": 1,
                  "step": 0.05,
                  "style": "slider",
                  "default": 0.8
                },
                "keywords": ["rate limit", "usage"],
                "migrate": [
                  {
                    "from": "minRateLimitNoticePercent",
                    "map": {
                      "scale": 0.01
                    }
                  }
                ]
              },
              {
                "id": "appendSystemPrompt",
                "label": "Extra system prompt",
                "summary": "Appended to Claude Code's system prompt for every session. Part of the cached prefix.",
                "input": {
                  "type": "code",
                  "language": "markdown",
                  "lines": 6
                },
                "advanced": true
              }
            ]
          },
          {
            "id": "tools",
            "label": "Tools",
            "summary": "What Claude Code may use besides valet's tools.",
            "items": [
              {
                "id": "hideBuiltinTools",
                "label": "Hide built-in tools",
                "summary": "Remove Claude Code's own tools (Bash, Read, Write, Edit, Agent, ...) so only valet's tools are offered.",
                "input": {
                  "type": "bool",
                  "default": false
                }
              },
              {
                "id": "disableClaudeAiConnectors",
                "label": "Hide claude.ai connectors",
                "summary": "Hide your claude.ai account connectors (Gmail, GitHub, ...). Built-in tools are not affected.",
                "input": {
                  "type": "bool",
                  "default": true
                }
              },
              {
                "id": "strictMcpConfig",
                "label": "Only valet's MCP servers",
                "summary": "Ignore project .mcp.json, user settings and plugins, so valet's is the only MCP server.",
                "input": {
                  "type": "bool",
                  "default": true
                }
              },
              {
                "id": "deferValetTools",
                "label": "Defer valet's tools",
                "summary": "Load valet's tools through Claude Code's tool search instead of the prompt.",
                "input": {
                  "type": "bool",
                  "default": false
                },
                "advanced": true
              },
              {
                "id": "denyTools",
                "label": "Denied tools",
                "summary": "Built-in tools Claude Code may never use, e.g. Bash.",
                "input": {
                  "type": "multiselect",
                  "style": "chips",
                  "options": {
                    "from": "builtinTools"
                  }
                },
                "advanced": true
              },
              {
                "id": "tools",
                "label": "Built-in tool set",
                "summary": "The built-in tools offered. Unset keeps Claude Code's defaults; empty removes them all.",
                "input": {
                  "type": "multiselect",
                  "style": "chips",
                  "options": {
                    "from": "builtinTools"
                  }
                },
                "advanced": true
              },
              {
                "id": "toolAliases",
                "label": "Tool aliases",
                "summary": "Run a built-in tool as another tool, e.g. Bash -> mcp__valet__exec.",
                "input": {
                  "type": "map",
                  "key": {
                    "type": "string",
                    "label": "Built-in tool"
                  },
                  "value": {
                    "type": "string",
                    "label": "Run as"
                  }
                },
                "advanced": true
              }
            ]
          },
          {
            "id": "models",
            "label": "Models",
            "items": [
              {
                "id": "models",
                "label": "Model list",
                "summary": "Replaces the built-in list. Rename or hide models on the Models page instead.",
                "input": {
                  "type": "list",
                  "item": {
                    "type": "group",
                    "inputs": [
                      {
                        "id": "id",
                        "type": "string",
                        "label": "Model id",
                        "required": true
                      },
                      {
                        "id": "name",
                        "type": "string",
                        "label": "Name"
                      },
                      {
                        "id": "contextWindow",
                        "type": "tokens",
                        "label": "Context window"
                      },
                      {
                        "id": "maxOutputTokens",
                        "type": "tokens",
                        "label": "Max output"
                      },
                      {
                        "id": "efforts",
                        "type": "multiselect",
                        "options": [
                          {
                            "value": "low"
                          },
                          {
                            "value": "medium"
                          },
                          {
                            "value": "high"
                          },
                          {
                            "value": "xhigh"
                          },
                          {
                            "value": "max"
                          }
                        ],
                        "label": "Efforts"
                      },
                      {
                        "id": "fast",
                        "type": "bool",
                        "label": "Fast mode"
                      }
                    ]
                  },
                  "addLabel": "Add model"
                },
                "advanced": true
              }
            ]
          },
          {
            "id": "runtime",
            "label": "Runtime",
            "items": [
              {
                "id": "settingSources",
                "label": "Settings files to load",
                "summary": "Claude Code settings files (and CLAUDE.md) to load. None by default: valet supplies the persona.",
                "input": {
                  "type": "multiselect",
                  "options": [
                    {
                      "value": "user"
                    },
                    {
                      "value": "project"
                    },
                    {
                      "value": "local"
                    }
                  ]
                },
                "advanced": true
              },
              {
                "id": "promptCacheTtl",
                "label": "Prompt cache TTL",
                "summary": "For the main conversation. Unset uses Anthropic's default.",
                "input": {
                  "type": "select",
                  "options": [
                    {
                      "value": "5m"
                    },
                    {
                      "value": "1h"
                    }
                  ]
                },
                "advanced": true
              },
              {
                "id": "subagentPromptCacheTtl",
                "label": "Subagent prompt cache TTL",
                "summary": "For Claude Code's own subagents.",
                "input": {
                  "type": "select",
                  "options": [
                    {
                      "value": "5m"
                    },
                    {
                      "value": "1h"
                    }
                  ]
                },
                "advanced": true
              },
              {
                "id": "idleCloseMs",
                "label": "Close idle sessions after (ms)",
                "summary": "The next prompt resumes the session. 0 keeps them open.",
                "input": {
                  "type": "duration",
                  "min": 0,
                  "default": "15m"
                },
                "advanced": true
              },
              {
                "id": "mcpToolTimeoutMs",
                "label": "Valet tool timeout (ms)",
                "summary": "How long Claude Code waits on one of valet's tools.",
                "input": {
                  "type": "duration",
                  "min": 1000
                },
                "advanced": true
              },
              {
                "id": "pathToClaudeCodeExecutable",
                "label": "Claude Code executable",
                "summary": "Unset uses the one bundled with the Agent SDK.",
                "input": {
                  "type": "path",
                  "kind": "file"
                },
                "advanced": true,
                "apply": "restart"
              }
            ]
          }
        ],
        "icon": "claude"
      }
    }
  }
}
